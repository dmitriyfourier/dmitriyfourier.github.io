<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    {% include '_partials/meta.liquid' %}
    {% include '_partials/fonts.liquid' %}
    {% include '_partials/favicons.liquid' %}
    {% include '_partials/alternates.liquid' %}
    <link rel="me" href="{{ site.mastodon }}">
    <link href="/assets/styles/tailwind.css?v={{ build.version }}" rel="stylesheet" />
    {% include '_partials/theme-init.liquid' %}
  </head>

  <body>
    {% include '_partials/header.liquid' %}
    <main id="main" tabindex="-1">
      {% unless content contains '<h1' %}
        <h1 class="sr-only">{{ title }}</h1>
      {% endunless %}

      {{ content }}
      {% include '_partials/markdown-note.liquid' %}
    </main>

    {% include '_partials/footer.liquid' %}
    <script src="/assets/scripts/theme.js?v={{ build.version }}"></script>
    {% if content contains 'class="fotorama"' %}
      <script src="/assets/scripts/jquery.min.js?v={{ build.version }}"></script>
      <script src="/assets/scripts/fotorama.min.js?v={{ build.version }}"></script>
      <script src="/assets/scripts/gallery.js?v={{ build.version }}"></script>
    {% endif %}
  </body>
</html>
