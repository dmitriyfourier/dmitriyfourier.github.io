{%- comment -%}
  Site header for every layout.
  variant: "blog" — blog feed: plain "Блог Димы Фурье" title, no menu links
{%- endcomment -%}
<a href="#main" class="skip-link">Перейти к содержимому</a>
<header>
  <nav id="header" class="w-full z-30 top-10 py-1" aria-label="Основное меню">
    <div class="w-full flex place-items-start justify-between mt-0 py-2">
      <div id="nav-menu" class="sm:flex sm:items-top sm:w-auto w-full order-1 sm:order-1">
        <div>
          <ul class="sm:flex items-center justify-between pt-0 sm:pt-0">
            <li class="flex flex-wrap justify-between items-center mx-auto max-w-(--breakpoint-2xl)">
              {%- if variant == "blog" %}
              <span class="flex items-center">
                <div class="ml-0.5 self-center font-semibold whitespace-nowrap text-fg">Блог Димы Фурье</div></span>
              {%- else %}
              <a href="/" class="flex items-center link-novisited no-underline">
                <span class="hidden sm:inline-block">   <img src="/assets/img/furye.jpg" class="mr-2 w-10 h-10 rounded-full" alt="" loading="eager" sizes="40px" eleventy:widths="40,80,120" /></span>
                <div class="ml-0.5 self-center font-semibold whitespace-nowrap text-fg">Дмитрий Фурье</div></a>
              {%- endif %}
            </li>
            {%- unless variant == "blog" %}
            <li><a class="inline-block link-novisited font-medium py-1 sm:pl-0 md:px-3"
                href="/podcasts/">Наговорил</a></li>
            {%- endunless %}
          </ul>
        </div>
      </div>

      <div id="nav-content" class="order-2 sm:order-3 flex flex-wrap flex-col-reverse items-top justify-end mr-0">
        <div id="nav-buttons" class="flex items-center w-full sm:w-full">
          <div class="px-4">
            {% include "_partials/theme-toggle.liquid" %}
          </div>
          {%- unless variant == "blog" %}
          <a href="/posts" class="inline-block py-1 link-novisited">Блог<span aria-hidden="true"> →</span></a>
          {%- endunless %}
        </div>
      </div>
    </div>
  </nav>
</header>
