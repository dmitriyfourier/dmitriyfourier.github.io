<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
  	<meta name='viewport' content='width=device-width'>
    {% if pagination.pageNumber > 0 %}
    <title>{{ title }} × [Страница {{ pagination.pageNumber }}]</title>
    <meta name='description' content="{{ desc }} × [Страница {{ pagination.pageNumber }}]">
    {% else %}
    <title>📋 Блог Димы Фурье</title>
    <meta name='description' content="{{ desc }}">
    {% endif %}
    <meta name="author" content="{{ site.author }}">

    <!--Open Graph-->
    {% if pagination.pageNumber > 0 %}
      <meta property="og:title" content="{{ title }} × [Страница {{ pagination.pageNumber }}]">
      <meta property="og:description" content="{{ desc }} × [Страница {{ pagination.pageNumber }}]">
      <meta property="og:image" content="{{ site.url }}/assets/covers/Notes-OG.jpg">
      
     {% else %}
     <meta property="og:title" content="{{ title }}">
     <meta property="og:description" content="{{ desc }}">
     <meta property="og:image" content="{{ site.url }}/assets/covers/Blog-OG.jpg">
    {% endif %}
    <meta property="og:site_name" content="fourier.rocks">
    <meta property="og:url" content="{{ site.url }}{{ page.url | url }}">
    <meta property="og:type" content="object">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="628">
  
    <!--links-->
    <link rel="canonical" href="{{ site.url }}{{ page.url | url }}">
     {% include "_partials/fonts.liquid" %}
      {% include "_partials/favicons.liquid" %}
      <link rel="me" href="{{ site.mastodon }}">
    <!--styles-->
    <link href="/assets/styles/tailwind.css" rel="stylesheet" />
    {% include "_partials/theme-init.liquid" %}
  </head>
 
<body>
    <header>
<nav id="header" class="w-full z-30 top-10 py-1">
  <div class="w-full flex place-items-start justify-between mt-0 py-2">

    <div id="mobileMenuButton" class="cursor-pointer hidden mr-6 left-0 top-0">
      <i class="las la-bars text-fg text-2xl"></i>
    </div>
    <!--     <input class="hidden" type="checkbox" id="menu-toggle"> -->

    <div id="nav-menu" class="sm:flex sm:items-top sm:w-auto w-full order-1 sm:order-1">
      <nav>
        <ul class="sm:flex items-center justify-between pt-0 sm:pt-0">
          <li class="flex flex-wrap justify-between items-center mx-auto max-w-(--breakpoint-2xl)">
            <span class="flex items-center">
              <div class="ml-0.5 self-center font-semibold whitespace-nowrap text-fg">Блог Димы Фурье</div></span>
          </li>
        </ul>
      </nav>
    </div>

    <div id="nav-content" class="order-2 sm:order-3 flex flex-wrap flex-col-reverse items-top justify-end mr-0">
      <div id="nav-buttons" class="flex items-center w-full sm:w-full">
        <div class="px-4">
          {% include "_partials/theme-toggle.liquid" %}
        </div>
      </div>
    </div>
  </div>
</nav>
    </header>
      <main class="">
        
        {{ content }}
      
      </main>
      
      <footer class="mt-4">
  <div class="mx-auto  pb-10">

      <!---->
      <div class="flex flex-wrap content-center">
        <div class="flex items-center text-muted hover:text-social-mastodon dark:hover:text-social-mastodon mr-6">
          <i class="lab la-mastodon text-2xl"></i>
          <a href="{{ site.mastodon }}" class="link-novisited">Мастадон</a>
        </div>

        <div class="flex items-center text-muted hover:text-social-linkedin dark:hover:text-social-linkedin mr-6">
          <i class="lab la-linkedin text-2xl no-underline"></i>
            <a href="{{ site.linkedin }}" class="link-novisited">ЛинкедИн</a>
        </div>

        <div class="flex items-center text-muted hover:text-social-instagram dark:hover:text-social-instagram mr-6">
          <i class="lab la-instagram text-2xl no-underline"></i>
            <a href="{{ site.instagramm }}" class="link-novisited">Инстаграм</a>
        </div>

        <div class="flex items-center text-muted hover:text-social-youtube dark:hover:text-social-youtube mr-6">
          <i class="lab la-youtube text-2xl no-underline"></i>
          <a href="{{ site.youtube }}" class="link-novisited">Ютуб</a>
        </div>

        <div class="flex items-center text-muted hover:text-social-telegram dark:hover:text-social-telegram mr-6">
          <i class="lab la-telegram text-2xl"></i>
            <a href="{{ site.telegram }}" class="link-novisited">Телеграм</a>
        </div>

        <div class="flex items-center sm:grow text-muted hover:text-social-epicgames dark:hover:text-social-steam-dark mr-6">
          <i class="lab la-steam text-2xl no-underline"></i>
            <a href="{{ site.steam }}" class="link-novisited">Стим</a>
        </div>
        <a href="/donation" class="link-novisited no-underline inline-flex items-center px-1 border border-current rounded-sm"
          aria-label="Поддержать Диму Фурье" title="Поддержать">
          <i class="text-2xl las la-piggy-bank" aria-hidden="true"></i></a>
      </div>
     
      <p class="text-sm py-2">
        <!--Добавляем автора сайта-->
        <span class="space-out-bottom-mili-xs">© {{ site.author }} × </span>
        <!--Добавляем копирайт на сайт и даты-->
        <span>2017 — {% year %}</span> </p>
  </div>
</footer>

  <script src="/assets/scripts/theme.js"></script>
      <script>
document.addEventListener('keydown', function(event) {
  // Проверяем, что нажата клавиша Ctrl
  if (event.ctrlKey) {
    // Проверяем, какая стрелка нажата
    if (event.key === 'ArrowDown') {
      // Ctrl + стрелка вниз
      event.preventDefault(); // Предотвращаем стандартное действие браузера
      var prevLink = document.getElementById('earlierPosts');
      if (prevLink) {
        window.location.href = prevLink.href;
      }
    } else if (event.key === 'ArrowUp') {
      // Ctrl + стрелка вверх
      event.preventDefault(); // Предотвращаем стандартное действие браузера
      var nextLink = document.getElementById('latestPosts');
      if (nextLink) {
        window.location.href = nextLink.href;
      }
    }
  }
});
</script>
  </body>
</html>