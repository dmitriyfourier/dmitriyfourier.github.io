{%- comment -%}
  Social links: [icon, label, url, hover color]. The last one grows to push
  the donation button to the right on wide screens.
{%- endcomment -%}
{%- capture social -%}
lab la-mastodon|Мастадон|{{ site.mastodon }}|hover:text-social-mastodon
lab la-linkedin|ЛинкедИн|{{ site.linkedin }}|hover:text-social-linkedin
lab la-instagram|Инстаграм|{{ site.instagramm }}|hover:text-social-instagram
lab la-youtube|Ютуб|{{ site.youtube }}|hover:text-social-youtube
lab la-telegram|Телеграм|{{ site.telegram }}|hover:text-social-telegram
lab la-steam|Стим|{{ site.steam }}|hover:text-social-epicgames dark:hover:text-social-steam-dark sm:grow
{%- endcapture -%}
<footer class="mt-4 pb-10">
  <div class="flex flex-wrap content-center">
    {%- assign rows = social | split: "
" %}
    {%- for row in rows %}
    {%- assign item = row | strip | split: "|" %}
    <div class="mr-6 flex items-center text-muted {{ item[3] }}">
      <i class="{{ item[0] }} text-2xl" aria-hidden="true"></i>
      <a href="{{ item[2] }}" class="link-novisited">{{ item[1] }}</a>
    </div>
    {%- endfor %}
    <a href="/donation" class="inline-flex items-center rounded-sm border border-current px-1 no-underline link-novisited"
      aria-label="Поддержать Диму Фурье" title="Поддержать">
      <i class="las la-piggy-bank text-2xl" aria-hidden="true"></i></a>
  </div>

  <p class="py-2 text-sm">© {{ site.author }} × 2017 — {% year %}</p>
</footer>
