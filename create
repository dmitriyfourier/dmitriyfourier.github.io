#!/bin/bash
# Creates a post in its own folder: src/posts/YYYY/MM/<slug>/<slug>.md
# Usage: bash create "Title of the post" [slug]
# Without a slug, it is made from the title (Cyrillic is transliterated),
# the same way the site makes tag URLs. The post is served at /posts/<slug>/.

set -e

TITLE=$1
if [ -z "$TITLE" ]; then
  echo 'Usage: bash create "Title of the post" [slug]' >&2
  exit 1
fi
SLUG=${2:-$(node -e 'console.log(require("slugify")(process.argv[1], { lower: true, strict: true, locale: "en" }))' "$TITLE")}

DIR="src/posts/$(date +%Y)/$(date +%m)/$SLUG"
FILENAME="$DIR/$SLUG.md"
if [ -e "$DIR" ]; then
  echo "$DIR already exists" >&2
  exit 1
fi

mkdir -p "$DIR"
cat <<EOF > "$FILENAME"
---
title: "$TITLE"
date: "$(date '+%Y-%m-%d')"
tags:
-
---

<!-- excerpt -->

EOF

echo "Created new post at $FILENAME"
echo "Put its images and files in $DIR/ and the post will be at /posts/$SLUG/"
