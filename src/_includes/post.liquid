---
layout: blog
---
<article class="article-post">
  <h1 class="mb-4">
    {{ title }}
  </h1>
  <div class="mb-4 text-muted">
    <em
      ><time datetime="{{ date | dateIso }}">
        {{- date | dateReadable -}}
      </time></em
    >
    •
    <span class="">Время чтения ≈ {{ content | readTime }} мин.</span>
  </div>
  <div>
    {{ content | eagerFirstImage }}
  </div>
</article>
<!-- # ===== Related Posts ==== # -->
{% include '_partials/similar.liquid' %}

<!-- # ===== Tags =====  # -->
<div class="mt-3 flex flex-wrap pb-4 text-xs">
  {% for tag in tags %}
    {% if tag != 'posts' %}
      <a class="link-novisited px-3 py-2" href="/tags/{{ tag | slug }}">
        <span>{{ tag }}</span>
      </a>
    {% endif %}
  {% endfor %}
</div>
<!-- # ===== Previous and Next =====  # -->
{%- if collections.posts %}
  {% assign previousPost = collections.posts | getPreviousCollectionItem: page %}
  {% assign nextPost = collections.posts | getNextCollectionItem: page %}
  {%- if nextPost or previousPost %}
    <hr>
    <nav class="flex justify-between" aria-label="Соседние записи">
      <div class="basis-1/2 justify-self-start">
        {%- if previousPost -%}
          <small class="text-muted" aria-hidden="true">Ctrl ←</small><br>
          <a
            href="{{ previousPost.url | url }}"
            class="link-novisited"
            id="previousPost"
            aria-keyshortcuts="Control+ArrowLeft"
          >
            {{- previousPost.data.title -}}
          </a>
        {%- endif %}
      </div>
      <div class="basis-1/2 justify-self-end">
        {%- if nextPost -%}
          <small class="text-muted" aria-hidden="true">Ctrl →</small><br>
          <a
            href="{{ nextPost.url | url }}"
            class="link-novisited"
            id="nextPost"
            aria-keyshortcuts="Control+ArrowRight"
          >
            {{- nextPost.data.title -}}
          </a>
        {%- endif %}
      </div>
    </nav>
  {%- endif %}
{%- endif %}
