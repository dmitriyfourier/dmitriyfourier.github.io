---
layout: blog
---
<article class="article-post" itemscope itemtype="https://schema.org/BlogPosting" itemid="{{ url }}">
<h1 class="mb-4" itemprop="name">
    {{ title}}
</h1>
<div class="mb-4 text-muted">
    <em><time itemprop="datePublished" datetime="{{ date | dateIso }}">{{ date | dateReadable }}</time></em> •
    <span class=>Время чтения ≈ {{ content | readTime }} мин.</span>
</div>
<div itemprop="articleBody">
  {{ content | eagerFirstImage }}
</div>
</article>
<!-- # ===== Related Posts ==== # -->
{% include "_partials/similar.liquid" %}

 

<!-- # ===== Tags =====  # -->
<div class="warp flex mt-3 pb-4 text-xs" itemprop="keywords">
	{% for tag in tags %}
	  {% if tag != "posts" %}
		<a class="link-novisited px-3 py-2" href="/tags/{{ tag | slug }}">
		  <span>{{ tag }}</span>
		</a>
	  {% endif %}
	{% endfor %}
	</div>
	<!-- # ===== Previous and Next =====  #-->
	{%- if collections.posts %}
	{% assign previousPost = collections.posts | getPreviousCollectionItem: page %}
	{% assign nextPost = collections.posts | getNextCollectionItem: page %}
	{%- if nextPost or previousPost %}
	<hr>
	<div class="flex flex-row justify-between">
	  <div class="basis-1/2 justify-self-start">{%- if previousPost %}<small class="text-muted">Ctrl ←</small><br><a href="{{ previousPost.url | url }}" class="link-novisited" id="previousPost">{{ previousPost.data.title }}</a>{% endif %}</div>
	  <div class="basis-1/2 justify-self-end">{%- if nextPost %}<small class="text-muted">Ctrl →</small><br><a href="{{ nextPost.url | url }}" class="link-novisited" id="nextPost">{{ nextPost.data.title }}</a>{% endif %}</div>
	</div>
	{%- endif %}
	{%- endif %}